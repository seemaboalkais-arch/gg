<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F8F9FA">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="سَرْمَد الذكي"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#212529"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/input_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/title"
        android:layout_above="@id/symbols_bar"
        android:layout_marginBottom="12dp"
        android:gravity="top|right"
        android:hint="اكتب أو الصق النص هنا..."
        android:padding="12dp"
        android:background="@drawable/edittext_bg"
        android:inputType="textMultiLine"
        android:scrollbars="vertical" />

    <!-- شريط الرموز الخاصة -->
    <LinearLayout
        android:id="@+id/symbols_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/buttons_container"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="12dp">
        
        <Button android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▴" android:onClick="addSymbol" style="?android:attr/borderlessButtonStyle"/>
        <Button android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✦" android:onClick="addSymbol" style="?android:attr/borderlessButtonStyle"/>
        <Button android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◥" android:onClick="addSymbol" style="?android:attr/borderlessButtonStyle"/>
        <Button android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▅" android:onClick="addSymbol" style="?android:attr/borderlessButtonStyle"/>
        <Button android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:onClick="addSymbol" style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/buttons_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_magic"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="2"
            android:text="الزر السحري ✨"
            android:backgroundTint="#6200EE"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_copy"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="نسخ"
            android:backgroundTint="#03DAC5"
            android:textColor="#000000" />
    </LinearLayout>
</RelativeLayout>
